# =====================================================================
# GATO DUMAS DASHBOARD — VARIABLES DE ENTORNO (PLANTILLA)
# Copia este archivo a `.env.local` y completa los valores.
# NUNCA commitees `.env.local`.  Ver docs/SEGURIDAD_TOKENS.md
# =====================================================================

# ---------------------------------------------------------------------
# GOOGLE SHEETS — PERSISTENTE (sí queda guardado en .env.local)
# ---------------------------------------------------------------------
# Sheet oficial PROD: DB_Dashboard_Gato_Dumas_Meta_Ads_PROD
# Ruta: CookMinds / Clientes / Gato Dumas / Dashboard Pauta
# Owner: cookmindsagency@gmail.com
GOOGLE_SHEET_ID=1Mbh7nkLQttvZOGzMZtQpsMlk3sGeG3R854KjyTomF-k
# Email del service account (termina en .iam.gserviceaccount.com).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada del service account. Valor completo entre comillas,
# conservando los \n literales del JSON descargado.
GOOGLE_PRIVATE_KEY=

# ---------------------------------------------------------------------
# META ADS — cuentas (persistente, NO son secretos)
# ---------------------------------------------------------------------
META_API_VERSION=v22.0
META_AD_ACCOUNT_GATO_COLOMBIA=act_299121374587072
META_AD_ACCOUNT_GATO_BUCARAMANGA=act_248616958293893

# ---------------------------------------------------------------------
# META ADS — TOKEN TEMPORAL  ⚠️ NO guardar permanentemente
# ---------------------------------------------------------------------
# El token de Meta se renueva y NO debe vivir en .env.local.
# Se entrega SOLO al momento de actualizar datos, por corrida:
#
#   Forma A (oficial):
#     META_ACCESS_TOKEN="EAAB..." npm run meta:update -- --range this_month --updatedBy Paola
#
#   Forma B (interactiva, pide el token sin mostrarlo):
#     npm run meta:update:manual -- --range this_month --updatedBy Paola
#
# Déjalo VACÍO aquí. Ver docs/OPERACION_ACTUALIZACION.md y docs/SEGURIDAD_TOKENS.md
META_ACCESS_TOKEN=

# ---------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------
NEXT_PUBLIC_CLIENT_NAME=Gato Dumas
NEXT_PUBLIC_TIMEZONE=America/Bogota

# =====================================================================
# 5 GATOS · BUCARAMANGA — dashboard cliente (/5gatos)
# =====================================================================

# Token de Meta para la vista 5 Gatos. En LOCAL usa META_ACCESS_TOKEN (arriba).
# En VERCEL créala con este nombre (token permanente del System User,
# ver docs/BUSINESS_MANAGER_SETUP.md):
META_ACCESS_TOKEN_5GATOS=

# Google Sheet "Mapeo_Cursos_5Gatos_Bucaramanga" (mapeo curso↔campaña,
# lo edita Ruzmery). Se crea/actualiza con: npx tsx scripts/setup-mapping-sheet.ts
GOOGLE_SHEET_MAPEO_5GATOS_ID=

# Secreto del cron /api/cron/refresh-5gatos (genera con: openssl rand -base64 32)
CRON_SECRET=

# --- Programación cursos Gato BGA (Sheet del cliente, lectura por SA) ---
# Owner: ramaya@gatodumas.com. Compartido con service account como Lector.
# ⚠️ Es un .xlsx (Office), NO un Google Sheet nativo: se lee vía Drive API
# (files.get alt=media) — la API "Google Drive" debe estar habilitada en el
# proyecto GCP del service account. Ver docs/PROGRAMACION_GATO_BGA_INTEGRACION.md
GOOGLE_SHEET_PROGRAMACION_GATO_BGA_ID=1cX7gHcuogtsZuKRYdm3XKB-5wNcgL406

# ---------------------------------------------------------------------
# LOGIN GOOGLE (next-auth v5) — ver docs/LOGIN_SETUP.md
# ---------------------------------------------------------------------
# Genera con: openssl rand -base64 32
AUTH_SECRET=
# Juan crea el OAuth Client en Google Cloud Console cuando vuelva
# (APIs & Services → Credentials → Create OAuth Client → Web Application).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Allowlist CSV de correos con acceso a /5gatos.
# Ej: AUTH_ALLOWED_EMAILS=ruzmery@cookminds.com,juan@5gatos.co
AUTH_ALLOWED_EMAILS=
